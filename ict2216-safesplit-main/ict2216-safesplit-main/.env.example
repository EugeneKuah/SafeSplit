# SafeSplit EC2 self-signed HTTPS configuration
# Copy to .env on the EC2 server. Do NOT commit .env.

DB_NAME=safesplit
DB_USER=safesplit_user
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET

# Replace with the EC2 public IPv4 address, for example 3.15.217.120.
TLS_HOST=REPLACE_WITH_EC2_PUBLIC_IPV4
FRONTEND_URL=https://REPLACE_WITH_EC2_PUBLIC_IPV4
